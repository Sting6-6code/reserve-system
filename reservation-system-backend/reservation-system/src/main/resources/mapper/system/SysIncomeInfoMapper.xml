<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.website.system.mapper.SysIncomeInfoMapper">

    <resultMap type="SysIncomeInfo" id="SysIncomeInfoResult">
        <result property="id"    column="id"    />
        <result property="date"    column="date"    />
        <result property="cc"    column="cc"    />
        <result property="balanceBeforeWork"    column="balance_before_work"    />
        <result property="cashIncome"    column="cash_income"    />
        <result property="giftCardIncome"    column="gift_card_income"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
    </resultMap>

    <sql id="selectSysIncomeInfoVo">
        select id, date, cc, balance_before_work, cash_income, gift_card_income, create_time, create_by from sys_income_info
    </sql>

    <select id="selectSysIncomeInfoList" parameterType="SysIncomeInfo" resultMap="SysIncomeInfoResult">
        <include refid="selectSysIncomeInfoVo"/>
        <where>
            <if test="date != null  and date != ''"> and date = #{date}</if>
        </where>
    </select>

    <select id="selectSysIncomeInfoById" parameterType="Long" resultMap="SysIncomeInfoResult">
        <include refid="selectSysIncomeInfoVo"/>
        where id = #{id}
    </select>

    <insert id="insertSysIncomeInfo" parameterType="SysIncomeInfo" useGeneratedKeys="true" keyProperty="id">
        insert into sys_income_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="date != null">date,</if>
            <if test="cc != null">cc,</if>
            <if test="balanceBeforeWork != null">balance_before_work,</if>
            <if test="cashIncome != null">cash_income,</if>
            <if test="giftCardIncome != null">gift_card_income,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="date != null">#{date},</if>
            <if test="cc != null">#{cc},</if>
            <if test="balanceBeforeWork != null">#{balanceBeforeWork},</if>
            <if test="cashIncome != null">#{cashIncome},</if>
            <if test="giftCardIncome != null">#{giftCardIncome},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
         </trim>
        ON DUPLICATE key update
        <if test="cc != null">cc=values(cc),</if>
        <if test="balanceBeforeWork != null">balance_before_work=values(balance_before_work),</if>
        <if test="cashIncome != null">cash_income=values(cash_income),</if>
        <if test="giftCardIncome != null">gift_card_income=values(gift_card_income),</if>
        create_time=values(create_time)
    </insert>

    <update id="updateSysIncomeInfo" parameterType="SysIncomeInfo">
        update sys_income_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="date != null">date = #{date},</if>
            <if test="cc != null">cc = #{cc},</if>
            <if test="balanceBeforeWork != null">balance_before_work = #{balanceBeforeWork},</if>
            <if test="cashIncome != null">cash_income = #{cashIncome},</if>
            <if test="giftCardIncome != null">gift_card_income = #{giftCardIncome},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysIncomeInfoById" parameterType="Long">
        delete from sys_income_info where id = #{id}
    </delete>

    <delete id="deleteSysIncomeInfoByIds" parameterType="String">
        delete from sys_income_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
