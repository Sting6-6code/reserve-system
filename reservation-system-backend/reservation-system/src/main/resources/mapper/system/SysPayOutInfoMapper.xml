<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.website.system.mapper.SysPayOutInfoMapper">

    <resultMap type="SysPayOutInfo" id="SysPayOutInfoResult">
        <result property="id"    column="id"    />
        <result property="payOutTime"    column="pay_out_time"    />
        <result property="payOutAmount"    column="pay_out_amount"    />
        <result property="payOutType"    column="pay_out_type"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="reason"    column="reason"    />

    </resultMap>

    <sql id="selectSysPayOutInfoVo">
        select id, pay_out_time, pay_out_amount,reason, pay_out_type, create_time, create_by from sys_pay_out_info
    </sql>

    <select id="selectSysPayOutInfoList" parameterType="SysPayOutInfo" resultMap="SysPayOutInfoResult">
        <include refid="selectSysPayOutInfoVo"/>
        <where>
            <if test="payOutTime != null  and payOutTime != ''"> and pay_out_time = #{payOutTime}</if>
            <if test="payOutType != null  and payOutType != ''"> and pay_out_type = #{payOutType}</if>
        </where>
    </select>

    <select id="selectSysPayOutInfoById" parameterType="Long" resultMap="SysPayOutInfoResult">
        <include refid="selectSysPayOutInfoVo"/>
        where id = #{id}
    </select>

    <insert id="insertSysPayOutInfo" parameterType="SysPayOutInfo" useGeneratedKeys="true" keyProperty="id">
        insert into sys_pay_out_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="payOutTime != null and payOutTime != ''">pay_out_time,</if>
            <if test="payOutAmount != null and payOutAmount != ''">pay_out_amount,</if>
            <if test="payOutType != null and payOutType != ''">pay_out_type,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="reason != null">reason,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="payOutTime != null and payOutTime != ''">#{payOutTime},</if>
            <if test="payOutAmount != null and payOutAmount != ''">#{payOutAmount},</if>
            <if test="payOutType != null and payOutType != ''">#{payOutType},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="reason != null">#{reason}</if>
         </trim>
    </insert>

    <update id="updateSysPayOutInfo" parameterType="SysPayOutInfo">
        update sys_pay_out_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="payOutTime != null and payOutTime != ''">pay_out_time = #{payOutTime},</if>
            <if test="payOutAmount != null and payOutAmount != ''">pay_out_amount = #{payOutAmount},</if>
            <if test="payOutType != null and payOutType != ''">pay_out_type = #{payOutType},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createBy != null">reason = #{reason},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysPayOutInfoById" parameterType="Long">
        delete from sys_pay_out_info where id = #{id}
    </delete>

    <delete id="deleteSysPayOutInfoByIds" parameterType="String">
        delete from sys_pay_out_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    <select id="selectPayOutAmount" parameterType="SysPayOutInfo" resultType="PayOutAmount">
        select
        sum(pay_out_amount) as total,
        sum(IF(pay_out_type='刷卡小费',pay_out_amount,0)) as skxf,
        sum(IF(pay_out_type='venmo小费',pay_out_amount,0)) as venmoxf,
        sum(IF(pay_out_type='其它',pay_out_amount,0)) as qtxf
        from sys_pay_out_info
        <where>
            <if test="payOutTime != null  and payOutTime != ''"> and pay_out_time like concat('%', #{payOutTime}, '%')</if>
        </where>

    </select>

</mapper>
