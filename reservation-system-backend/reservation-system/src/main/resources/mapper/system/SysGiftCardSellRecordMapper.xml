<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.website.system.mapper.SysGiftCardSellRecordMapper">

    <resultMap type="SysGiftCardSellRecord" id="SysGiftCardSellRecordResult">
        <result property="id"    column="id"    />
        <result property="giftCardType"    column="gift_card_type"    />
        <result property="giftCardCode"    column="gift_card_code"    />
        <result property="giftCardSellPrice"    column="gift_card_sell_price"    />
        <result property="giftCardDeductionPrice"    column="gift_card_deduction_price"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="sellDate"    column="sell_date"    />
        <result property="sk"    column="sk"    />
        <result property="xj"    column="xj"    />
        <result property="dz"    column="dz"    />
        <result property="customId"    column="custom_id"    />
        <result property="customNickName"    column="custom_nick_name"    />

    </resultMap>

    <sql id="selectSysGiftCardSellRecordVo">
        select A.id, A.gift_card_type,A.custom_id,concat(B.custom_nick_name,'(',B.custom_phone,')') as custom_nick_name,A.sell_date, A.gift_card_code, A.gift_card_sell_price, A.gift_card_deduction_price, A.status, A.create_time, A.create_by,
        (select gift_card_pay_amount from sys_gift_card_order where gift_card_code =A.gift_card_code and gift_card_pay_type='现金支付') as xj,
        (select gift_card_pay_amount from sys_gift_card_order where gift_card_code =A.gift_card_code and gift_card_pay_type='电子支付') as dz,
        (select gift_card_pay_amount from sys_gift_card_order where gift_card_code =A.gift_card_code and gift_card_pay_type='刷卡支付') as sk from sys_gift_card_sell_record A
        left join sys_custom_info B on A.custom_id=B.custom_id

    </sql>

    <select id="selectSysGiftCardSellRecordList" parameterType="SysGiftCardSellRecord" resultMap="SysGiftCardSellRecordResult">
        <include refid="selectSysGiftCardSellRecordVo"/>
        <where>
            <if test="giftCardType != null  and giftCardType != ''"> and A.gift_card_type = #{giftCardType}</if>
            <if test="giftCardCode != null  and giftCardCode != ''"> and A.gift_card_code like concat('%', #{giftCardCode}, '%')</if>
            <if test="sellDate != null  and sellDate != ''"> and A.sell_date like concat('%', #{sellDate}, '%')</if>
            <if test="status != null  and status != ''"> and A.status = #{status}</if>
            <if test="customNickName != null  and customNickName != ''"> and (B.custom_nick_name like concat('%', #{customNickName}, '%') or B.custom_phone like concat('%', #{customNickName}, '%')) </if>
        </where>
    </select>

    <select id="selectSysGiftCardSellRecordById" parameterType="Long" resultMap="SysGiftCardSellRecordResult">
        <include refid="selectSysGiftCardSellRecordVo"/>
        where A.id = #{id}
    </select>

    <select id="selectSysGiftCardSellRecordByIds" parameterType="String" resultType="SysGiftCardSellRecord">
        select * from sys_gift_card_sell_record where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <insert id="insertSysGiftCardSellRecord" parameterType="SysGiftCardSellRecord" useGeneratedKeys="true" keyProperty="id">
        insert into sys_gift_card_sell_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="giftCardType != null">gift_card_type,</if>
            <if test="giftCardCode != null">gift_card_code,</if>
            <if test="giftCardSellPrice != null">gift_card_sell_price,</if>
            <if test="giftCardDeductionPrice != null">gift_card_deduction_price,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="sellDate != null">sell_date,</if>
            <if test="customId != null">custom_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="giftCardType != null">#{giftCardType},</if>
            <if test="giftCardCode != null">#{giftCardCode},</if>
            <if test="giftCardSellPrice != null">#{giftCardSellPrice},</if>
            <if test="giftCardDeductionPrice != null">#{giftCardDeductionPrice},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="sellDate != null">#{sellDate},</if>
            <if test="customId != null">#{customId},</if>
         </trim>
    </insert>

    <update id="updateSysGiftCardSellRecord" parameterType="SysGiftCardSellRecord">
        update sys_gift_card_sell_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="giftCardType != null">gift_card_type = #{giftCardType},</if>
            <if test="giftCardCode != null">gift_card_code = #{giftCardCode},</if>
            <if test="giftCardSellPrice != null">gift_card_sell_price = #{giftCardSellPrice},</if>
            <if test="giftCardDeductionPrice != null">gift_card_deduction_price = #{giftCardDeductionPrice},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="customId != null">custom_id=#{customId},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="updateSysGiftCardSellRecordStatus" parameterType="SysGiftCardSellRecord">
        update sys_gift_card_sell_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="giftCardType != null">gift_card_type = #{giftCardType},</if>
            <if test="giftCardSellPrice != null">gift_card_sell_price = #{giftCardSellPrice},</if>
            <if test="giftCardDeductionPrice != null">gift_card_deduction_price = #{giftCardDeductionPrice},</if>
            <if test="status != null"> `status`= #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
        </trim>
        where gift_card_code = #{giftCardCode}
    </update>

    <delete id="deleteSysGiftCardSellRecordById" parameterType="Long">
        delete from sys_gift_card_sell_record where id = #{id}
    </delete>

    <delete id="deleteSysGiftCardSellRecordByIds" parameterType="String">
        delete from sys_gift_card_sell_record where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
