<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.website.system.mapper.SysServiceInfoMapper">

    <resultMap type="SysServiceInfo" id="SysServiceInfoResult">
        <result property="id"    column="id"    />
        <result property="serviceName"    column="service_name"    />
        <result property="serviceTime"    column="service_time"    />
        <result property="servicePrice"    column="service_price"    />
        <result property="serviceDetail"    column="service_detail"    />
        <result property="parentId"    column="parent_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="serviceWages"    column="service_wages"    />
    </resultMap>

    <sql id="selectSysServiceInfoVo">
        select id, service_name, service_wages,service_time, service_price, service_detail, parent_id, create_by, create_time from sys_service_info
    </sql>

    <select id="selectSysServiceInfoList" parameterType="SysServiceInfo" resultMap="SysServiceInfoResult">
        <include refid="selectSysServiceInfoVo"/>
        <where>
            <if test="serviceName != null  and serviceName != ''"> and service_name like concat('%', #{serviceName}, '%')</if>
        </where>
    </select>

    <select id="selectSysServiceInfoById" parameterType="Long" resultMap="SysServiceInfoResult">
        <include refid="selectSysServiceInfoVo"/>
        where id = #{id}
    </select>

    <insert id="insertSysServiceInfo" parameterType="SysServiceInfo">
        insert into sys_service_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="serviceName != null">service_name,</if>
            <if test="serviceTime != null">service_time,</if>
            <if test="servicePrice != null">service_price,</if>
            <if test="serviceDetail != null">service_detail,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="serviceWages != null">service_wages,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="serviceName != null">#{serviceName},</if>
            <if test="serviceTime != null">#{serviceTime},</if>
            <if test="servicePrice != null">#{servicePrice},</if>
            <if test="serviceDetail != null">#{serviceDetail},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="serviceWages != null">#{serviceWages},</if>
         </trim>
    </insert>

    <update id="updateSysServiceInfo" parameterType="SysServiceInfo">
        update sys_service_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="serviceName != null">service_name = #{serviceName},</if>
            <if test="serviceTime != null">service_time = #{serviceTime},</if>
            <if test="servicePrice != null">service_price = #{servicePrice},</if>
            <if test="serviceDetail != null">service_detail = #{serviceDetail},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="serviceWages != null">service_wages=#{serviceWages},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysServiceInfoById" parameterType="Long">
        delete from sys_service_info where id = #{id}
    </delete>

    <delete id="deleteSysServiceInfoByIds" parameterType="String">
        delete from sys_service_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
