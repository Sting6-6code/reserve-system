<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.website.system.mapper.SysEmployeeInfoMapper">

    <resultMap type="SysEmployeeInfo" id="SysEmployeeInfoResult">
        <result property="employeeId"    column="employee_id"    />
        <result property="coverImage"    column="cover_image"    />
        <result property="personalIntroduction"    column="personal_introduction"    />
        <result property="employeeCode"    column="employee_code"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="nickName"    column="nick_name"></result>
        <result property="birth"    column="birth"></result>
        <result property="phone"    column="phone"></result>
        <result property="activeOrNot"    column="active_or_not"></result>
        <result property="orderNum"    column="order_num"></result>

    </resultMap>

    <sql id="selectSysEmployeeInfoVo">
        select employee_id,nick_name,birth,phone,active_or_not, cover_image,order_num, personal_introduction, employee_code, create_by, create_time from sys_employee_info
    </sql>

    <select id="selectSysEmployeeInfoList" parameterType="SysEmployeeInfo" resultMap="SysEmployeeInfoResult">
        <include refid="selectSysEmployeeInfoVo"/>
        <where>
            <if test="activeOrNot != null "> and sys_employee_info.active_or_not = #{activeOrNot}</if>
            <if test="employeeId != null "> and sys_employee_info.employee_id = #{employeeId}</if>
            <if test="employeeCode != null  and employeeCode != ''"> and sys_employee_info.employee_code = #{employeeCode}</if>
            <if test="nickName != null  and nickName != ''"> and sys_employee_info.nick_name like concat('%',#{nickName}'%') </if>
        </where>
    order by sys_employee_info.order_num
    </select>

    <select id="selectSysEmployeeInfoByEmployeeId" parameterType="Long" resultMap="SysEmployeeInfoResult">
        <include refid="selectSysEmployeeInfoVo"/>
        where employee_id = #{employeeId}
    </select>

    <insert id="insertSysEmployeeInfo" parameterType="SysEmployeeInfo" useGeneratedKeys="true" keyProperty="employeeId">
        insert into sys_employee_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="employeeId!=null">employee_id,</if>
            <if test="coverImage != null">cover_image,</if>
            <if test="personalIntroduction != null">personal_introduction,</if>
            <if test="employeeCode != null">employee_code,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="nickName != null">nick_name,</if>
            <if test="birth != null">birth,</if>
            <if test="phone != null">phone,</if>
            <if test="activeOrNot != null">active_or_not,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="employeeId!=null">#{employeeId},</if>
            <if test="coverImage != null">#{coverImage},</if>
            <if test="personalIntroduction != null">#{personalIntroduction},</if>
            <if test="employeeCode != null">#{employeeCode},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="nickName != null">#{nickName},</if>
            <if test="birth != null">#{birth},</if>
            <if test="phone != null">#{phone},</if>
            <if test="activeOrNot != null">#{activeOrNot},</if>
         </trim>
    </insert>

    <update id="updateSysEmployeeInfo" parameterType="SysEmployeeInfo">
        update sys_employee_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="personalIntroduction != null">personal_introduction = #{personalIntroduction},</if>
            <if test="employeeCode != null">employee_code = #{employeeCode},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="nickName != null">nick_name=#{nickName},</if>
            <if test="birth != null">birth=#{birth},</if>
            <if test="phone != null">phone=#{phone},</if>
            <if test="activeOrNot != null">active_or_not=#{activeOrNot},</if>
        </trim>
        where employee_id = #{employeeId}
    </update>

    <delete id="deleteSysEmployeeInfoByEmployeeId" parameterType="Long">
        delete from sys_employee_info where employee_id = #{employeeId}
    </delete>

    <delete id="deleteSysEmployeeInfoByEmployeeIds" parameterType="String">
        delete from sys_employee_info where employee_id in
        <foreach item="employeeId" collection="array" open="(" separator="," close=")">
            #{employeeId}
        </foreach>
    </delete>
</mapper>
